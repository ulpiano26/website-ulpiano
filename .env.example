# HubSpot Forms Submission API v3 (portal 148805200)
HUBSPOT_PORTAL_ID=148805200
HUBSPOT_FORM_ID_CONTACT=
HUBSPOT_FORM_ID_DEMO=
HUBSPOT_FORM_ID_RESOURCE=
HUBSPOT_FORM_ID_NEWSLETTER=
HUBSPOT_SUBSCRIPTION_TYPE_ID=

# Demo request backend (public URL, no secrets). Defaults to the production endpoint if unset.
# The server also reads DEMO_REQUEST_ENDPOINT. The public variable remains for compatibility.
DEMO_REQUEST_ENDPOINT=https://gestormercantil.com/api/soporte/demos
NEXT_PUBLIC_DEMO_REQUEST_ENDPOINT=https://gestormercantil.com/api/soporte/demos

# Aviso por correo a soporte cuando entra un formulario (Google Workspace).
# Sin SMTP_HOST, SMTP_USER y SMTP_PASS el aviso no se envía; el lead sigue
# guardándose en el backend de soporte si ese canal responde.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_EMAIL=soporte@ulpiano.es
LEAD_NOTIFY_FROM=
